# Used by scripts/provision.ts and scripts/seed.ts (never by the browser).
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=<PROJECT_ID>
# An API key with the databases, tables, columns, indexes, rows, buckets, files, tokens, and users scopes.
APPWRITE_API_KEY=<API_KEY>
# Password for the two demo users that scripts/seed.ts creates.
SEED_PASSWORD=<AT_LEAST_8_CHARACTERS>
